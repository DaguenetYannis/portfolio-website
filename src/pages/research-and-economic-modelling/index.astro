---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Research and Economic Modelling | Yannis Daguenet"
  description="Research and economic modelling prototypes, methods, and interactive analytical tools."
>
  <section class="research-section">
    <div class="container-narrow">
      <p class="eyebrow">Research and Economic Modelling</p>
      <h1>Research and Economic Modelling</h1>
      <p class="hero-text">
        This section gathers research prototypes, modelling work, and exploratory tools that sit between empirical
        analysis and interactive communication.
      </p>

      <div class="research-list">
        <article class="research-item">
          <p class="item-kicker">Interactive network</p>
          <h2><a href="/research-and-economic-modelling/occupation-space">Espace des m&eacute;tiers</a></h2>
          <p>
            Static proof of concept for the national PCS occupational space, rendered as a Sigma.js network from
            browser-ready JSON data.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-section {
    padding: var(--space-3xl) 0;
  }

  .eyebrow,
  .item-kicker {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-4xl);
    line-height: 1.05;
  }

  .hero-text {
    margin-bottom: var(--space-2xl);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .research-list {
    display: grid;
    gap: var(--space-lg);
  }

  .research-item {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .research-item h2 {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-2xl);
  }

  .research-item a {
    color: var(--color-text);
    text-decoration: none;
  }

  .research-item a:hover {
    color: var(--color-accent-primary);
  }

  .research-item p:last-child {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .research-section {
      padding: var(--space-2xl) 0;
    }

    h1 {
      font-size: var(--font-size-3xl);
    }
  }
</style>

