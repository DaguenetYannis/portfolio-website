---
// Homepage - Landing page
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import VisualPanel from '@/components/visuals/VisualPanel.astro';

const sampleVisualization = '/outputs/plots/adaptive-green-transition/phase_space_sector_green_readiness_outgoing_3d_1995_2016_portfolio.png';

const selectedProjects = [
  {
    id: 'project-005',
    title: 'CBAM, ETS Revenues, and Industrial Competitiveness',
    description: 'An applied climate-policy analysis of CBAM, ETS free allowance phase-out, revenue effects, and industrial competitiveness.',
    tags: ['climate policy', 'carbon pricing', 'CBAM'],
    outputType: 'analysis' as const,
    status: 'completed' as const,
    href: '/projects/cbam-ets-industrial-competitiveness'
  },
  {
    id: 'project-004',
    title: 'Adaptive Green Transition in Global Production Networks',
    description: 'A framework for studying heterogeneous green transition pathways in a networked global production system.',
    tags: ['agent-based modelling', 'economic complexity', 'green transition'],
    outputType: 'research' as const,
    status: 'completed' as const,
    href: '/projects/adaptive-green-transition'
  }
];
---

<BaseLayout title="Analytical Portfolio" description="Policy and institutional analytical portfolio">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Analytical Portfolio</h1>
        <p class="hero-subtitle">
          Policy and institutional analysis through rigorous methodology and clear visualization.
        </p>
      </div>
    </div>
  </section>

  <!-- Institutional Profile -->
  <section class="profile">
    <div class="container-narrow">
      <h2>About This Portfolio</h2>
      <p>
        This is a portfolio of analytical work focused on institutional policy research and governance analysis. Projects demonstrate methodological rigor, institutional insight, and the ability to communicate complex findings.
      </p>
      <p>
        All work follows a calm, institutional aesthetic designed for clarity and credibility.
      </p>
    </div>
  </section>

  <!-- Selected Projects -->
  <section class="projects">
    <div class="container">
      <h2>Recent Work</h2>
      <div class="project-grid">
        {selectedProjects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            tags={project.tags}
            outputType={project.outputType}
            status={project.status}
            href={project.href}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href="/projects" class="cta-link">View all projects →</a>
      </div>
    </div>
  </section>

  <!-- Methods Snapshot -->
  <section class="methods">
    <div class="container-narrow">
      <h2>Methodology</h2>
      <p>
        This work emphasizes institutional analysis, policy frameworks, and evidence-based assessment. Projects integrate:
      </p>
      <ul class="methods-list">
        <li>Systematic institutional mapping</li>
        <li>Rigorous policy analysis</li>
        <li>Evidence synthesis and synthesis</li>
        <li>Clear visual communication</li>
      </ul>
      <p>
        <a href="/methods">Learn more about methodology →</a>
      </p>
    </div>
  </section>

  <!-- Visual Preview Section -->
  <section class="visual-preview">
    <div class="container">
      <VisualPanel
        title="Sample Visualization"
        caption="Sector trajectories in green readiness space."
        showAction={false}
      >
        <img class="sample-visualization" src={sampleVisualization} alt="Sector trajectories in green readiness space" />
      </VisualPanel>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-3xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-bg) 0%,
      var(--color-surface) 100%
    );
  }

  .hero-content {
    max-width: 900px;
  }

  .hero h1 {
    font-size: var(--font-size-4xl);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.8;
  }

  .profile {
    padding: var(--space-3xl) 0;
  }

  .profile p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.8;
  }

  .projects {
    padding: var(--space-3xl) 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-xl);
    margin: var(--space-2xl) 0;
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .cta-link {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cta-link:hover {
    color: var(--color-accent-primary-hover);
  }

  .methods {
    padding: var(--space-3xl) 0;
  }

  .methods-list {
    margin: var(--space-xl) 0;
    padding-left: var(--space-xl);
  }

  .methods-list li {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .visual-preview {
    padding: var(--space-3xl) 0;
  }

  .sample-visualization {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-2xl) 0;
    }

    .hero h1 {
      font-size: var(--font-size-3xl);
    }

    .hero-subtitle {
      font-size: var(--font-size-base);
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .profile,
    .projects,
    .methods,
    .visual-preview {
      padding: var(--space-2xl) 0;
    }
  }
</style>
