---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import VisualPanel from '@/components/visuals/VisualPanel.astro';

const plotBase = '/outputs/plots/adaptive-green-transition';

const heroImage = `${plotBase}/abm_v4_architecture_layers_polished.png`;
const decompositionPlot = `${plotBase}/abm_v4_emissions_decomposition_logic_polished.png`;
const twoRulePlot = `${plotBase}/abm_v4_two_rule_scorecard.png`;
const chinaElectricityPlot = `${plotBase}/abm_v4_china_electricity_boundary_case_polished.png`;
const qEnergyPlot = `${plotBase}/abm_v4_q_energy_mix_quality_boundary_web.png`;
const roadmapPlot = `${plotBase}/abm_v4_to_v5_roadmap_polished.png`;

const badges = [
  'Agent-based modelling',
  'Input-output networks',
  'Economic complexity',
  'Historical validation',
  'Emissions diagnostics',
  'Python pipeline',
  'Large-scale data',
  'Model governance'
];

const implementationStats = [
  { label: 'Country-sector agents', value: '4,915' },
  { label: 'Historical period', value: '1995-2016' },
  { label: 'State-panel rows', value: '108,130' },
  { label: 'Supplier opportunities', value: '308,920' },
  { label: 'Final tests passed', value: '398' },
  { label: 'Model status', value: 'Diagnostic, not scenario-ready' }
];

const storySteps = [
  {
    title: 'The economic question',
    skills: 'Policy modelling, economic reasoning',
    text: 'How does the global production network reorganize under green transition pressures? How do capability accumulation, network embeddedness, supplier dependence, production feasibility, and emissions-transition pressure jointly shape green reorganization in the global country-sector production network?'
  },
  {
    title: 'The modelling choice',
    skills: 'Agent-based modelling, input-output analysis',
    text: 'The model treats each country-sector as an adaptive agent embedded in suppliers, buyers, capabilities, emissions intensity, and productive ecosystems.'
  },
  {
    title: 'The validation discipline',
    skills: 'Historical validation, model diagnostics',
    text: 'Instead of moving directly to scenarios, ABM v4 tests whether proposed transition mechanisms survive historical evidence from 1995 to 2016.'
  },
  {
    title: 'The boundary found',
    skills: 'Critical model assessment, research design',
    text: 'The model is useful as a historical diagnostic framework, but not yet as a forecasting engine. The failures identify what ABM v5 must add: energy structure, policy regimes, capital-stock inertia, and richer agent types.'
  }
];

const architectureCards = [
  {
    title: 'Country-sector agents',
    skills: 'Panel data modelling, data architecture',
    text: 'The model represents 4,915 country-sector nodes observed across 22 years, combining output, emissions intensity, network position, capabilities, and ecosystem fields.'
  },
  {
    title: 'Production network constraints',
    skills: 'Input-output networks, supplier analysis',
    text: 'Supplier opportunities are not random. They are built from raw Eora transaction data, historical ties, sector proximity, and ecosystem feasibility.'
  },
  {
    title: 'Capability measurement',
    skills: 'Economic complexity, missing-data strategy',
    text: 'Capabilities are source-aware: Atlas-observed when available, IO-imputed when defensible, and explicitly unavailable when neither source is reliable.'
  },
  {
    title: 'Emissions decomposition',
    skills: 'Carbon accounting, transition diagnostics',
    text: 'Emissions changes are separated into scale, intensity, and interaction effects, avoiding the mistake of treating output decline as green transition.'
  }
];

const validationCards = [
  {
    title: 'A raw emissions-intensity rule was rejected',
    skills: 'Model criticism, theoretical consistency',
    text: 'The first emissions rule was too mechanical. High emissions intensity should not automatically imply fast decarbonisation. It should indicate distance from a feasible frontier.'
  },
  {
    title: 'Two historical rules were retained',
    skills: 'Model comparison, calibration diagnostics',
    text: 'One rule performs better as an aggregate-safe baseline. The other gives a cleaner transition-mechanism benchmark. Neither is strong enough for policy scenarios.'
  },
  {
    title: 'Energy data became a boundary case',
    skills: 'Data quality auditing, energy-system analysis',
    text: 'Q energy mix variables are useful at aggregate level, but not reliable enough for node-level behavioural rules inside ABM v4.'
  },
  {
    title: 'ABM v5 now has a clearer agenda',
    skills: 'Research roadmap design, model governance',
    text: 'The validation failures are productive: they define the next model, with explicit energy/fuel structure, policy and investment regimes, capital-stock inertia, and richer agent ontologies.'
  }
];

const skills = [
  'Agent-based modelling',
  'Input-output economics',
  'Economic complexity',
  'Historical validation',
  'Carbon-transition diagnostics',
  'Network analysis',
  'Large-scale Parquet workflows',
  'Python package design',
  'CLI workflow design',
  'Pytest-based validation',
  'Data quality auditing',
  'Model boundary definition',
  'Scenario-readiness assessment',
  'Technical documentation',
  'Policy-oriented modelling',
  'Research communication'
];
---

<BaseLayout
  title="Adaptive Green Transition in Global Production Networks"
  description="A portfolio case study on agent-based modelling, input-output networks, economic complexity, and historical validation for green transition analysis."
>
  <section class="project-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Portfolio case study</p>
          <h1>Adaptive Green Transition in Global Production Networks</h1>

          <p class="hero-subtitle">
            I built a historical agent-based modelling pipeline to study how green transition pressures move through global production networks.
          </p>

          <p class="hero-text">
            The project turns a broad policy question into a tested modelling system: how can country-sector production nodes reduce emissions intensity without simply shrinking output? It combines input-output economics, economic complexity, emissions accounting, supplier-network analysis, and historical validation.
          </p>

          <p class="hero-text">
            The final ABM v4 is not presented as a forecasting tool. Its value is methodological: it shows how to build, test, reject, and retain transition mechanisms in a disciplined way before making scenario claims.
          </p>

          <div class="badge-list">
            {badges.map((badge) => (
              <span class="badge">{badge}</span>
            ))}
          </div>

          <div class="project-links">
            <a href="/projects" class="text-link">Back to projects</a>
            <a href="/" class="text-link">Homepage</a>
          </div>
        </div>

        <div class="hero-media">
          <VisualPanel
            title="ABM v4 historical diagnostic stack"
            caption="The project moves from historical data inputs to model validation and a clearly defined ABM v5 agenda."
            showAction={false}
          >
            <img class="hero-plot" src={heroImage} alt="ABM v4 architecture as a historical diagnostic stack" />
          </VisualPanel>
        </div>
      </div>
    </div>
  </section>

  <section class="project-status">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Project outcome</p>
        <h2>A complete historical diagnostic model, that ambitions to turn into a simulator</h2>
        <p>
          ABM v4 reached a useful endpoint: a tested historical modelling pipeline that identifies which transition mechanisms are defensible, which fail validation, and which missing economic structures must be added before policy scenarios.
        </p>
      </div>

      <div class="stat-grid">
        {implementationStats.map((stat) => (
          <div class="stat-card">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="story-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Story of the project</p>
        <h2>From a policy intuition to a validated modelling boundary</h2>
        <p>
          A model should reveal when its own assumptions are not strong enough in order to build a stronger foundation.
        </p>
      </div>

      <div class="story-grid">
        {storySteps.map((step, index) => (
          <article class="story-card">
            <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="skill-line">{step.skills}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="executive-argument">
    <div class="container-narrow">
      <p class="eyebrow">Economic intuition</p>
      <h2>Why green transition has to be modelled as a production-system problem</h2>

      <p>
        This project starts from a simple problem: it is not enough to ask whether emissions decline. For public policy, the harder question is whether the economy is actually developing the productive conditions that make a lower-carbon trajectory possible. A fall in emissions can come from cleaner production, but also from output contraction, relocation, or the disappearance of carbon-intensive activity from the observed system. The model therefore treats transition as a problem of productive transformation, not only as an environmental accounting result.
      </p>

      <p>
        In the thesis framework, ecological transition is a process of modification of the productive system. Extraction, transformation, energy use, material flows, technologies, suppliers, and markets all have to be reorganized if economic activity is to reduce its environmental footprint while maintaining development possibilities. This is why the project uses the idea of a productive ecosystem: sectors are not isolated units, but parts of a wider structure of input-output relations, capabilities, infrastructures, and international dependencies.
      </p>

      <p>
        The Remaster project extends this intuition to the global production network. Green production is not defined as a fixed list of green industries, nor as a simple threshold of emissions intensity. A country-sector can appear relatively clean locally while depending on carbon-intensive upstream inputs, or it can look dirty while supplying activities that reduce emissions elsewhere. Green-ness is therefore treated as a relational property: it depends on where a node sits in the production network, who it buys from, who it supplies, and how carbon circulates through value chains.
      </p>

      <p>
        This is where complexity economics becomes useful. The global economy is treated as a complex adaptive system: heterogeneous country-sector nodes interact through production networks, adjust under constraints, and generate aggregate patterns that are not imposed in advance. The model does not assume that the system moves smoothly toward one optimal equilibrium. It looks for path dependence, lock-in, thresholds, feedback loops, and transition corridors: the mechanisms through which some parts of the production system move toward greener configurations while others remain structurally brown.
      </p>

      <p>
        Economic complexity adds the capability constraint. A country-sector cannot arbitrarily jump into any cleaner activity or technology. Its transition possibilities depend on existing productive knowledge, supplier structures, technical routines, infrastructure, and adjacent capabilities. In the model, this means that green reorganization is not only a matter of pressure or ambition. It is also a matter of feasibility: what each country-sector is close enough to produce, adopt, substitute, or learn.
      </p>

      <p>
        ABM v4 operationalizes this reasoning. It represents the world economy as country-sector agents embedded in input-output networks, then tests whether emissions-intensity change can be explained through frontier gaps, capabilities, supplier exposure, ecosystem position, and historical validation. The result is deliberately cautious. The model is not yet a scenario engine. Its value is to show what can be validated historically, what cannot, and which missing mechanisms must be added before credible transition scenarios can be built.
      </p>
    </div>
  </section>

  <section class="visual-section alternate">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Core accounting logic</p>
        <h2>Falling emissions is not automatically green transition</h2>
        <p>
          The model separates emissions change into scale effects, intensity effects, and interaction effects. This distinction is central. A decline in emissions caused by lower output is not treated as evidence of productive decarbonisation.
        </p>
        <p class="skills-note">
          Skills used: carbon accounting, decomposition logic, transition diagnostics, model interpretation.
        </p>
      </div>

      <VisualPanel
        title="Emissions decomposition"
        caption="The model distinguishes output-scale effects from actual emissions-intensity improvement."
        showAction={false}
      >
        <img src={decompositionPlot} alt="ABM v4 emissions decomposition logic" />
      </VisualPanel>
    </div>
  </section>

  <section class="architecture-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Model architecture</p>
        <h2>What was built</h2>
        <p>
          ABM v4 is a Python modelling pipeline built around country-sector agents, Eora input-output data, emissions intensity, capability measurement, supplier opportunities, and historical validation.
        </p>
      </div>

      <div class="phase-grid">
        {architectureCards.map((phase) => (
          <article class="phase-card">
            <h3>{phase.title}</h3>
            <p>{phase.text}</p>
            <span class="skill-line">{phase.skills}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="visual-section">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Capability measurement</p>
        <h2>Turning missing data into a modelling decision</h2>
        <p>
          The project does not treat every missing capability value as the same problem. Atlas product-space information is used where meaningful. IO-based capability proxies are used where production-network evidence is sufficient. Remaining unavailable cases are explicitly flagged instead of silently filled.
        </p>
        <p class="skills-note">
          Skills used: economic complexity, data quality assessment, feature engineering, transparent imputation.
        </p>
      </div>

      <VisualPanel
        title="Source-aware capability assignment"
        caption="Capability coverage after combining Atlas-observed and IO-imputed information."
        showAction={false}
      >
        <img src={`${plotBase}/abm_v4_capability_source_coverage_polished.png`} alt="Capability source coverage after IO imputation" />
      </VisualPanel>
    </div>
  </section>

  <section class="validation-section alternate">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Historical validation</p>
        <h2>What the model learned by trying to fail</h2>
        <p>
          The most important part of ABM v4 is not that a model was implemented. It is that mechanisms were tested, rejected, retained, or downgraded based on historical evidence.
        </p>
      </div>

      <div class="validation-grid">
        {validationCards.map((finding) => (
          <article class="validation-card">
            <h3>{finding.title}</h3>
            <p>{finding.text}</p>
            <span class="skill-line">{finding.skills}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="visual-section">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Model comparison</p>
        <h2>Why ABM v4 retains two historical rules</h2>
        <p>
          The validation did not produce one clean winner. One rule is better for aggregate emissions plausibility, while another gives a cleaner transition-mechanism interpretation. Rather than forcing a false conclusion, ABM v4 keeps both as diagnostic references.
        </p>
        <p class="skills-note">
          Skills used: model comparison, validation metrics, calibration diagnostics, scientific restraint.
        </p>
      </div>

      <VisualPanel
        title="Two-rule validation result"
        caption="ABM v4 retains an aggregate-safe baseline and a transition-mechanism benchmark."
        showAction={false}
      >
        <img src={twoRulePlot} alt="Scorecard explaining why ABM v4 retains two historical rules" />
      </VisualPanel>
    </div>
  </section>

  <section class="visual-section alternate">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Energy-system boundary</p>
        <h2>China electricity exposed what the model still cannot represent</h2>
        <p>
          Electricity is not just another sector. It is infrastructure-heavy, politically regulated, fuel-mix dependent, and essential to the rest of the economy. The China electricity case showed that ABM v4 lacks the energy-system and policy variables needed to explain such nodes as ordinary country-sector agents.
        </p>
        <p class="skills-note">
          Skills used: energy-system diagnosis, anomaly interpretation, historical data audit, model-boundary analysis.
        </p>
      </div>

      <VisualPanel
        title="China electricity as a boundary case"
        caption="Fuel-mix evidence supports the need for explicit energy-system modelling, but does not by itself prove a causal mechanism."
        showAction={false}
      >
        <img src={chinaElectricityPlot} alt="China electricity fuel mix and observed emissions-intensity reduction" />
      </VisualPanel>
    </div>
  </section>

  <section class="visual-section">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Data quality boundary</p>
        <h2>Q energy mix is useful evidence, but not yet rule-grade data</h2>
        <p>
          The Q energy rows can support aggregate energy diagnostics. However, negative source values and node-level quality problems make them too risky for country-sector behavioural rules inside ABM v4.
        </p>
        <p class="skills-note">
          Skills used: data audit, quality checks, evidence grading, scenario-readiness assessment.
        </p>
      </div>

      <VisualPanel
        title="Q energy mix quality boundary"
        caption="The data are useful for aggregate diagnosis, but not reliable enough for node-level behavioural simulation."
        showAction={false}
      >
        <img src={qEnergyPlot} alt="Q energy mix quality boundary web summary" />
      </VisualPanel>
    </div>
  </section>

  <section class="scenario-boundary">
    <div class="container-narrow">
      <p class="eyebrow">Scenario readiness</p>
      <h2>The honest conclusion: ABM v4 is not a policy-scenario engine yet</h2>

      <p>
        ABM v4 is strong as a historical diagnostic framework. It has a tested codebase, explicit model logic, validated accounting, and a clear mechanism register. But it should not yet be used to make future scenario claims.
      </p>

      <p>
        The reason is precise: no single emissions-transition rule is strong enough for scenarios; production dynamics are still historically forced; energy and fuel structures are not modelled at sufficient quality; and policy/institutional variables are absent.
      </p>

      <p>
        This is a positive modelling result. The project does not hide uncertainty. It converts failed mechanisms into a concrete ABM v5 research agenda.
      </p>
    </div>
  </section>

  <section class="visual-section alternate">
    <div class="container">
      <div class="visual-copy">
        <p class="eyebrow">Research roadmap</p>
        <h2>ABM v4 validation failures define the ABM v5 design</h2>
        <p>
          The final output is not only a model. It is a research roadmap. ABM v5 should move from a country-sector diagnostic model toward a richer agent system with energy/fuel structure, policy and investment regimes, endogenous production dynamics, and capital-stock inertia.
        </p>
        <p class="skills-note">
          Skills used: model governance, research design, technical roadmap, policy-oriented systems thinking.
        </p>
      </div>

      <VisualPanel
        title="From ABM v4 boundaries to ABM v5 requirements"
        caption="Each validation failure becomes a specific modelling requirement for the next version."
        showAction={false}
      >
        <img src={roadmapPlot} alt="ABM v4 validation failures defining the ABM v5 roadmap" />
      </VisualPanel>
    </div>
  </section>

  <section class="skills-demonstrated">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Skills demonstrated</p>
        <h2>What this project demonstrates</h2>
        <p>
          The project combines economic modelling, data engineering, validation discipline, and policy-oriented communication. The technical work matters, but the central skill is turning an ambitious research question into a controlled modelling pipeline with clear limits.
        </p>
      </div>

      <div class="skill-grid">
        {skills.map((skill) => (
          <span>{skill}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="interpretation-limits">
    <div class="container-narrow">
      <p class="eyebrow">How to read this project</p>
      <h2>A portfolio piece about rigorous modelling, not overconfident prediction</h2>

      <p>
        This project should be read as evidence of modelling judgement. It shows the ability to build a large historical simulation pipeline, test mechanisms against data, reject attractive but weak rules, and communicate the boundary between diagnosis and forecasting.
      </p>

      <p>
        The central contribution is methodological: ABM v4 makes green transition more precise by separating emissions-intensity improvement from output decline, by embedding agents in a production network, and by turning validation failures into a stronger ABM v5 agenda.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero,
  .project-status,
  .story-section,
  .executive-argument,
  .architecture-section,
  .visual-section,
  .validation-section,
  .scenario-boundary,
  .skills-demonstrated,
  .interpretation-limits {
    padding: var(--space-3xl) 0;
  }

  .alternate {
    background: color-mix(in srgb, var(--color-surface) 45%, transparent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-plot {
    width: 100%;
    max-height: 560px;
    object-fit: contain;
  }

  .section-heading {
    max-width: 900px;
    margin-bottom: var(--space-2xl);
  }

  .section-heading p {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .eyebrow {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
  }

  h1 {
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-4xl);
    line-height: 1.05;
  }

  h2 {
    margin: 0 0 var(--space-lg);
  }

  h3 {
    margin: 0 0 var(--space-md);
    color: var(--color-text);
  }

  .hero-subtitle {
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
  }

  .hero-text,
  .executive-argument p,
  .visual-copy p,
  .scenario-boundary p,
  .interpretation-limits p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-2xl) 0;
  }

  .badge {
    background-color: var(--color-surface);
    color: var(--color-text);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
  }

  .text-link {
    color: var(--color-accent-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .text-link:hover {
    color: var(--color-accent-primary-hover);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .stat-card,
  .story-card,
  .phase-card,
  .validation-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .stat-value {
    display: block;
    color: var(--color-accent-primary);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .stat-label {
    display: block;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .story-grid,
  .phase-grid,
  .validation-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .story-card p,
  .phase-card p,
  .validation-card p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .step-number {
    display: inline-block;
    color: var(--color-accent-primary);
    font-size: var(--font-size-sm);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .skill-line {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.5;
    font-weight: 600;
  }

  .skills-note {
    color: var(--color-text-muted) !important;
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-top: var(--space-lg);
  }

  .visual-section .container {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .visual-copy {
    max-width: 620px;
  }

  .visual-section img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .skill-grid span {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    display: inline-block;
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 1100px) {
    .stat-grid,
    .story-grid,
    .phase-grid,
    .validation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .visual-section .container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    h1 {
