---
import BaseLayout from '@/components/layout/BaseLayout.astro';

const badges = [
  'TypeScript',
  'Vite',
  'Vitest',
  'Static maps',
  'UX design',
  'Frontend',
  'Travel planning'
];

const technicalApproach = [
  'Built with Vite and TypeScript.',
  'Structured around small domain models for stops, experiences and transport options.',
  'Used static map images and calibrated marker positions instead of relying on slow remote map tiles.',
  'Added city and day-trip overlays for a more image-led exploration experience.',
  'Added car-free transport notes for Lake Constance day trips.',
  'Used Vitest to protect itinerary ordering, filtering, repositories and UI behavior.',
  'Designed the app to run as a static frontend with no backend.'
];

const screenshots = [
  {
    title: 'Route map',
    path: '/images/travel-itinerary/route-map.png'
  },
  {
    title: 'City overlay',
    path: '/images/travel-itinerary/city-overlay.png'
  },
  {
    title: 'Day-trip overlay',
    path: '/images/travel-itinerary/daytrip-overlay.png'
  }
];
---

<BaseLayout
  title="Interactive Travel Itinerary App"
  description="A static TypeScript travel-planning app for exploring a car-free itinerary through Strasbourg, Freiburg, Konstanz and Lake Constance."
>
  <section class="project-hero">
    <div class="container-narrow">
      <p class="eyebrow">Product / frontend experiment</p>
      <h1>Interactive Travel Itinerary App</h1>
      <p class="hero-subtitle">
        A static TypeScript travel-planning app for exploring a car-free itinerary through Strasbourg, Freiburg, Konstanz and Lake Constance.
      </p>
      <p class="hero-text">
        I built this small itinerary app to plan and present a car-free trip through Strasbourg, Freiburg im Breisgau, Konstanz and Lake Constance. The goal was not to build another generic travel website, but to create a visual planning tool that could be used on a laptop screen to compare cities, day trips, images, transport options and moods.
      </p>
      <p class="hero-text">
        The app uses static maps and local image assets instead of relying on live map tiles. The route map acts as the home screen, while city and day-trip overlays provide a more visual exploration layer with image carousels, practical notes, mood filters and car-free transport information.
      </p>
      <div class="badge-list">
        {badges.map((badge) => (
          <span class="badge">{badge}</span>
        ))}
      </div>
      <div class="project-links">
        <a href="/projects" class="text-link">Back to projects</a>
      </div>
    </div>
  </section>

  <section class="argument-section">
    <div class="container-narrow">
      <h2>Problem</h2>
      <p>
        I wanted a travel-planning interface that was more useful than a note document and more personal than a standard map. The trip was designed without a car, so the app needed to make routes, day trips and transport constraints visible while still feeling pleasant to browse.
      </p>
    </div>
  </section>

  <section class="argument-section">
    <div class="container-narrow">
      <h2>What I built</h2>
      <p>
        The app combines a static itinerary map, city exploration overlays, day-trip overlays, image carousels, mood filters and practical transport notes. The main route covers Strasbourg, Freiburg im Breisgau and Konstanz, with Lake Constance day trips such as Mainau, Reichenau, Meersburg, Lindau, Stein am Rhein, Rhine Falls and St. Gallen.
      </p>
    </div>
  </section>

  <section class="screenshots-section">
    <div class="container">
      <div class="section-heading">
        <h2>Screenshots</h2>
        <p>
          Selected screens from the final static itinerary app.
        </p>
      </div>
      <div class="screenshot-grid">
        {screenshots.map((screenshot) => (
          <figure class="screenshot-card">
            <img src={screenshot.path} alt={`${screenshot.title} screenshot`} loading="lazy" />
            <figcaption>{screenshot.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="argument-section">
    <div class="container-narrow">
      <h2>Technical approach</h2>
      <ul class="technical-list">
        {technicalApproach.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="argument-section">
    <div class="container-narrow">
      <h2>Why it matters</h2>
      <p>
        This project was useful because it turned a real planning problem into a small product. It required data modelling, UI decisions, testing, visual hierarchy, asset management and iteration based on actual use. It is not a data analysis case study, but it shows how I approach practical tools: start from a concrete need, structure the information, test the logic and refine the interface until it becomes usable.
      </p>
    </div>
  </section>

  <section class="argument-section">
    <div class="container-narrow">
      <h2>Limitations</h2>
      <p>
        The app uses static content and does not fetch live schedules, prices or opening hours. Some images and map assets may need to be replaced or attributed before a fully public release. The project is best understood as a product and frontend experiment rather than a production travel service.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero,
  .argument-section,
  .screenshots-section {
    padding: var(--space-3xl) 0;
  }

  .screenshots-section {
    background: color-mix(in srgb, var(--color-surface) 45%, transparent);
  }

  .eyebrow {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
  }

  h1 {
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-4xl);
    line-height: 1.05;
  }

  .hero-subtitle {
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    max-width: 860px;
  }

  .hero-text,
  .argument-section p,
  .section-heading p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-2xl) 0;
  }

  .badge {
    background-color: var(--color-surface);
    color: var(--color-text);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
  }

  .text-link {
    color: var(--color-accent-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .text-link:hover {
    color: var(--color-accent-primary-hover);
  }

  .section-heading {
    max-width: 820px;
    margin-bottom: var(--space-xl);
  }

  .screenshot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    max-width: 1120px;
    margin: 0 auto;
  }

  .screenshot-card {
    margin: 0;
    background-color: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 18px 44px color-mix(in srgb, #000 22%, transparent);
  }

  .screenshot-card img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 760px;
    object-fit: contain;
    background-color: var(--color-surface);
  }

  .screenshot-card figcaption {
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-lg);
    font-weight: 700;
    font-size: var(--font-size-sm);
  }

  .technical-list {
    margin: var(--space-lg) 0 0;
    padding-left: var(--space-xl);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .technical-list li {
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: var(--font-size-3xl);
    }

    .project-links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
