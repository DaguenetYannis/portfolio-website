---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';

const projectCategories = [
  {
    id: 'research-economic-modelling',
    title: 'Research & Economic Modelling',
    description: 'Projects focused on policy analysis, economic systems, transition dynamics, and empirical modelling.',
    overviewDescription: 'Policy analysis, economic systems, transition dynamics, and empirical modelling.',
    projects: [
      {
        title: 'Adaptive Green Transition in Global Production Networks',
        description: 'A framework for studying green transition pathways as heterogeneous, path-dependent movements in a networked production system.',
        tags: ['agent-based modelling', 'economic complexity', 'network analysis'],
        outputType: 'research' as const,
        status: 'completed' as const,
        href: '/projects/adaptive-green-transition'
      },
      {
        title: 'CBAM, ETS Revenues, and Industrial Competitiveness',
        description: 'An applied climate-policy analysis of CBAM, ETS free allowance phase-out, revenue effects, and industrial competitiveness.',
        tags: ['climate policy', 'carbon pricing', 'industrial strategy'],
        outputType: 'analysis' as const,
        status: 'completed' as const,
        href: '/projects/cbam-ets-industrial-competitiveness'
      },
      {
        title: 'Did the Eurozone Protect Trade During the Great Trade Collapse?',
        description: 'A structural gravity and difference-in-difference project analysing whether Eurozone membership reduced the trade impact of the 2008 financial crisis.',
        tags: ['international economics', 'structural gravity', 'PPML', 'trade resilience'],
        outputType: 'research' as const,
        status: 'completed' as const,
        href: '/projects/eurozone-trade-resilience'
      },
      {
        title: 'Did Lockdowns Reduce Urban Economic Activity?',
        description: 'An urban economics project using daily mobility and greenhouse gas emissions data to study whether the Paris lockdown produced a distinct local economic shock.',
        tags: ['urban economics', 'Covid-19', 'difference-in-difference', 'emissions proxy'],
        outputType: 'research' as const,
        status: 'completed' as const,
        href: '/projects/covid-urban-mobility-emissions'
      }
    ]
  },
  {
    id: 'data-analysis-machine-learning',
    title: 'Data Analysis & Machine Learning',
    description: 'Projects focused on predictive modelling, data engineering, machine learning workflows, and applied quantitative analysis.',
    overviewDescription: 'Predictive modelling, data engineering, machine-learning workflows, and applied quantitative analysis.',
    projects: [
      {
        title: 'Predicting Socio-Economic Status from Administrative and Geographic Data',
        description: 'A machine-learning project turning heterogeneous socio-economic, employment, sports-association, and geographic data into a predictive model for an anonymised target variable.',
        tags: ['machine learning', 'feature engineering', 'imputation', 'geospatial data'],
        outputType: 'analysis' as const,
        status: 'completed' as const,
        href: '/projects/socioeconomic-status-prediction'
      },
      {
        title: 'Fiscal Vulnerability Analysis of French Municipalities',
        description: 'An end-to-end data pipeline processing 43 years of French local tax data into fiscal capacity, fiscal effort, and vulnerability indicators over 1.34M valid commune-year observations.',
        tags: ['Data pipeline', 'public finance', 'Parquet', 'scoring', 'diagnostics'],
        outputType: 'analysis' as const,
        status: 'in-progress' as const,
        href: '/projects/fiscal-vulnerability-municipalities'
      }
    ]
  },
  {
    id: 'product-experiments',
    title: 'Product Experiments',
    description: 'Side technical projects focused on practical tools, frontend implementation, and product iteration.',
    overviewDescription: 'Practical tools, frontend implementation, and product iteration.',
    projects: [
      {
        title: 'Interactive Travel Itinerary App',
        description: 'A visual itinerary-planning app for a car-free trip through Strasbourg, Freiburg, Konstanz and Lake Constance. Built with Vite, TypeScript, static maps, image-led overlays, transport notes and tested domain logic.',
        tags: ['TypeScript', 'Vite', 'Vitest', 'UX design', 'Static maps'],
        outputType: 'product' as const,
        status: 'completed' as const,
        href: '/projects/interactive-travel-itinerary-app'
      }
    ]
  }
];
---

<BaseLayout title="Projects | Analytical Portfolio">
  <section class="projects-page">
    <div class="container">
      <h1>Projects</h1>
      <p class="intro-text">
        Selected analytical work in policy, institutional research, and network-based modelling.
      </p>
      <div class="category-overview" aria-label="Project categories">
        <div class="category-folder-grid">
          {projectCategories.map((category) => (
            <a class="category-folder-card" href={`#${category.id}`}>
              <div class="category-folder-header">
                <h2>{category.title}</h2>
                <span class="category-folder-meta">
                  {category.projects.length} {category.projects.length === 1 ? 'project' : 'projects'}
                </span>
              </div>
              <p>{category.overviewDescription}</p>
              <ul class="category-folder-list">
                {category.projects.map((project) => (
                  <li>{project.title}</li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </div>
      {projectCategories.map((category) => (
        <section id={category.id} class="project-category">
          <div class="category-heading">
            <h2>{category.title}</h2>
            <p>{category.description}</p>
          </div>
          <div class="project-grid">
            {category.projects.map((project) => (
              <ProjectCard
                title={project.title}
                description={project.description}
                tags={project.tags}
                outputType={project.outputType}
                status={project.status}
                href={project.href}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding: var(--space-3xl) 0;
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  .intro-text {
    color: var(--color-text-secondary);
    max-width: 760px;
    line-height: 1.8;
    margin-bottom: var(--space-xl);
  }

  .category-overview {
    margin: var(--space-2xl) 0 var(--space-3xl);
  }

  .category-folder-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .category-folder-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background-color: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .category-folder-card:hover,
  .category-folder-card:focus-visible {
    background-color: var(--color-surface);
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .category-folder-card:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 3px;
  }

  .category-folder-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }

  .category-folder-header h2 {
    margin: 0;
    font-size: var(--font-size-xl);
    line-height: 1.25;
  }

  .category-folder-meta {
    flex-shrink: 0;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.35rem 0.65rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .category-folder-card p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-lg);
  }

  .category-folder-list {
    display: grid;
    gap: var(--space-sm);
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .category-folder-list li {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-sm);
    line-height: 1.45;
    transition: border-color var(--transition-fast);
  }

  .category-folder-card:hover .category-folder-list li,
  .category-folder-card:focus-visible .category-folder-list li {
    border-color: var(--color-accent-primary);
  }

  .project-category {
    scroll-margin-top: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  .project-category + .project-category {
    margin-top: var(--space-3xl);
  }

  .category-heading {
    max-width: 820px;
    margin-bottom: var(--space-xl);
  }

  .category-heading h2 {
    margin-bottom: var(--space-sm);
  }

  .category-heading p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 640px) {
    .projects-page {
      padding: var(--space-2xl) 0;
    }

    .category-folder-grid {
      grid-template-columns: 1fr;
    }

    .category-folder-header {
      flex-direction: column;
    }
  }
</style>
